# RadLabel configuration template.
# Copy to `.env` and fill in the blanks. `.env` is git-ignored; this file is committed.
# Read by src/radlabel/config.py (pydantic-settings). Comments are on their own lines on purpose.

# ───────────── LLM provider ─────────────
# azure | openai
LLM_PROVIDER=azure

# Azure AI Foundry → your resource → "Keys and Endpoint" (copy exactly)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Copy from the deployment's sample code and keep it pinned
AZURE_OPENAI_API_VERSION=

# Deployment NAMES as created in Azure AI Foundry, one per role (SPEC §7.1)
# Tier 1 labelling (the tagger)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Tier 1 fallback
AZURE_OPENAI_FALLBACK_DEPLOYMENT=gpt-5.4-mini
# Agents: verifier agent, query agent (v1: Tier 2 repair agent)
AZURE_OPENAI_REPAIR_DEPLOYMENT=gpt-5-mini
# Question paraphrasing
AZURE_OPENAI_CHEAP_DEPLOYMENT=gpt-5.4-nano
# Optional retrieval baseline row only (not used in serving)
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Model versions shown in the deploy dialog (policy: "Upgrade when expired"); written into every results file
AZURE_OPENAI_DEPLOYMENT_VERSION=
AZURE_OPENAI_FALLBACK_DEPLOYMENT_VERSION=
AZURE_OPENAI_REPAIR_DEPLOYMENT_VERSION=
AZURE_OPENAI_CHEAP_DEPLOYMENT_VERSION=

# Tier 1 model-selection pilot (M4): ~100 training-fold reports per candidate
PILOT_DEPLOYMENTS=gpt-4.1-mini,gpt-5.4-mini,gpt-5.4-nano

# Only if LLM_PROVIDER=openai
OPENAI_API_KEY=

# ───────────── Rate limits and budget ─────────────
# TPM = the DEPLOYMENT allocation you set when deploying (not the shared quota)
TIER1_TPM=500000
REPAIR_TPM=375000
CHEAP_TPM=200000
# Azure counts max_tokens against TPM, so keep it tight
TIER1_MAX_TOKENS=800
# Upper bound; the client also derives concurrency from TPM / (prompt + max_tokens)
LLM_MAX_CONCURRENCY=16
# Hard stop in code (also set an Azure Cost Management budget alert)
MAX_LLM_USD=20
# Private, git-ignored
LLM_CACHE_DIR=artifacts/llm_cache

# ───────────── Local models ─────────────
EMBED_BASE_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# auto | cpu | cuda
DEVICE=auto
# Private path or private bucket URI; never public
MODEL_STORE=./models

# ───────────── Services (docker compose defaults) ─────────────
DATABASE_URL=postgresql://radlabel:radlabel@postgres:5432/radlabel
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# ───────────── Tracing ─────────────
# phoenix | langfuse | none
TRACING_BACKEND=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ───────────── App ─────────────
SEED=13
API_RATE_LIMIT=30/minute
LOG_LEVEL=INFO
